{
  "info": {
    "_postman_id": "vendor-crm-dev2-collection",
    "name": "Vendor CRM - Developer 2 Modules API Collection",
    "description": "Comprehensive Postman test collection for Developer 2 modules:\n1. Product & Service Management\n2. Inventory Management\n3. Invoice & Payment Management\n4. Vendor Performance Management\n\nIncludes positive and negative test cases with automatic token extraction and assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Authentication & Setup Prerequisites",
      "item": [
        {
          "name": "0.1 Register Admin User (Initial Setup)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 409 Conflict (already registered)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"email\": \"admin@vendorcrm.com\",\n  \"password\": \"admin123\",\n  \"fullName\": \"System Administrator\",\n  \"phoneNumber\": \"+1-555-0199\",\n  \"roles\": [\"ROLE_ADMIN\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "0.2 Login as Admin (Token Generation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data) {",
                  "    var token = jsonData.data.accessToken || jsonData.data.token;",
                  "    if (token) {",
                  "        pm.environment.set(\"jwt_token\", token);",
                  "        console.log(\"Saved JWT Token to environment: \" + token.substring(0, 15) + \"...\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "0.3 Create Sample Vendor (Prerequisite for Modules 1-4)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 200/409\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set(\"vendor_id\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
